name: {{ plan_name }}
root: .
{% if pre_window %}
pre_window: {{ pre_window }}
{% endif %}

windows:
{%- if windows %}
{%- for window in windows %}
  - {{ window.name }}:
      layout: {{ window.layout }}
      {%- if window.pre_window %}
      pre_window: {{ window.pre_window }}
      {%- endif %}
      panes:
      {%- for pane in window.panes %}
        {%- if pane is none %}
        -
        {%- elif pane is string %}
          {%- if pane == "" %}
        -
          {%- else %}
        - {{ pane }}
          {%- endif %}
        {%- else %}
          {%- if pane.package %}
        {#- The cmd is double-quoted into a single bash -lc argument so shell
            syntax (&&, ;, loops, pipes) executes INSIDE the container, not in
            the host pane shell (which would split the airfield invocation).
            Host-side $VAR expansion still happens (double quotes), so env like
            $HOME or ${MAP:-default} resolves at launch time. #}
        - airfield package cmd {{ pane.package }} -- bash -lc "{{ pane.cmd | replace("\\", "\\\\") | replace("\"", "\\\"") }}"
          {%- else %}
        - {{ pane.cmd }}
          {%- endif %}
        {%- endif %}
      {%- endfor %}
{%- endfor %}
{%- else %}
{%- for pkg in packages %}
  - {{ pkg }}:
      panes:
        - airfield project run {{ pkg }}
{%- endfor %}
{%- endif %}

