name: {{ plan_name }}
root: .
{% if pre_window %}
pre_window: {{ pre_window }}
{% endif %}

windows:
{%- if windows %}
{%- for window in windows %}
  - {{ window.name }}:
      layout: {{ window.layout }}
      {%- if window.pre_window %}
      pre_window: {{ window.pre_window }}
      {%- endif %}
      panes:
      {%- for pane in window.panes %}
        {%- if pane is none %}
        -
        {%- elif pane is string %}1
          {%- if pane == "" %}
        -
          {%- else %}
        - {{ pane }}
          {%- endif %}
        {%- else %}
          {%- if pane.package %}
        - airfield package cmd {{ pane.package }} -- bash -lc 'cd ~/workspace && mkdir -p build install log && if colcon list -n 2>/dev/null | grep -qx {{ pane.package }} && [ ! -e install/{{ pane.package }} ]; then flock log/.colcon_build.lock colcon build --packages-up-to {{ pane.package }} || exit 1; fi && if [ -f install/setup.bash ]; then source install/setup.bash; fi && {{ pane.cmd }}'
          {%- else %}
        - {{ pane.cmd }}
          {%- endif %}
        {%- endif %}
      {%- endfor %}
{%- endfor %}
{%- else %}
{%- for pkg in packages %}
  - {{ pkg }}:
      panes:
        - airfield project run {{ pkg }}
{%- endfor %}
{%- endif %}

